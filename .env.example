ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=creditos;Username=creditos;Password=change-me
Jwt__Issuer=creditos-api
Jwt__Audience=creditos-mobile
Jwt__Key=replace-with-a-long-random-key-at-least-32-characters
Jwt__ExpirationMinutes=60
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Username=your-account@gmail.com
Smtp__Password=your-gmail-app-password
Smtp__FromEmail=your-account@gmail.com
Smtp__FromName=Creditos
Smtp__UseSsl=false
Smtp__UseStartTls=true
CreditNotification__RecipientEmail=creditos@gmail.com
AllowedOrigins=http://localhost:8100,http://localhost:5173
DemoUsers__Enabled=true
DemoUsers__Password=Demo1234!
